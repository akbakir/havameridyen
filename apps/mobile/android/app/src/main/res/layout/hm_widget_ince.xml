<?xml version="1.0" encoding="utf-8"?>
<!-- havameridyen widget İ · ince 4×1: şimdi; sağda yer, saat, uyum çubuğu (widget6, 25 Ekim). Metin boyları dp: telefonun yazı büyüklüğü taşırmasın. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wsky_nodata"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/wx_cloud" />

    <TextView
        android:id="@+id/w_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="—"
        android:textColor="@color/hm_w_text"
        android:textSize="30dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_cond"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/hm_w_text"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/w_p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/hm_w_rain"
                android:textSize="11dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_minmax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:shadowColor="@color/hm_w_halo"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="7"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/hm_w_soft"
            android:textSize="13dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="110dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/hm_w_text"
            android:textSize="13dp" />

        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/hm_w_faint"
            android:textSize="10dp" />

        <FrameLayout
            android:id="@+id/w_bar"
            android:layout_width="30dp"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/w_bar_bg"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/w_barc"
                android:layout_width="26dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/w_bar" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/hm_w_rain"
                android:textSize="            dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

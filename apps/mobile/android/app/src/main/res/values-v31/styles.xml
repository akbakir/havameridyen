<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ sistem açılış ekranı: düz zemin + ortada ikon (turkuaz, köşeleri yuvarlatılmış kare; kare
         splash_icon'un içinde çizili, sistemin daire zemini yok) + altta marka yazısı -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">@color/hm_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_brand</item>
    </style>
</resources>
